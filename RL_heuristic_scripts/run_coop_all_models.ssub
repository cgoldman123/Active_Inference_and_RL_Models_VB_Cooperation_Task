#!/bin/bash
#
#SBATCH --partition=c3
#SBATCH --ntasks=1
#SBATCH --mem=3000
#SBATCH --nodes=1
# #SBATCH --chdir=/media/labs/rsmith/lab-members/osanchez/wellbeing/cooperation/scripts/other_models/RL_RW/Final_RL_KPC_heuristic/
#SBATCH --begin=now
#
#################################################

SUBJECT=$1
export SUBJECT

RESULTS=$2
export RESULTS

FIELD=$3
export FIELD

EXPERIMENT=$4
export EXPERIMENT

USER_NAME=$USER

echo "Bash detected username: $USER_NAME"

if [ "$USER_NAME" == "osanchez" ]; then
    cd /media/labs/rsmith/lab-members/osanchez/wellbeing/cooperation/scripts/other_models/RL_RW/Final_RL_KPC_heuristic/
elif [ "$USER_NAME" == "gkozlowski" ]; then
    cd /media/labs/rsmith/lab-members/gkozlowski/Cooperation/Active_Inference_and_RL_Models_VB_Cooperation_Task/RL_heuristic_scripts/
elif [ "$USER_NAME" == "kchou" ]; then
    cd /media/labs/rsmith/lab-members/kchou/COP_wellbeing/Final_RL_KPC_heuristic/
fi


module load matlab/2022a
#run_file='/media/labs/rsmith/lab-members/osanchez/wellbeing/cooperation/scripts/other_models/RL_RW/Final_RL_KPC_heuristic/main_script_RL.m'
if [ "$USER" == "osanchez" ]; then
    run_file='/media/labs/rsmith/lab-members/osanchez/wellbeing/cooperation/scripts/other_models/RL_RW/Final_RL_KPC_heuristic/main_script_RL.m'
elif [ "$USER" == "gkozlowski" ]; then
    run_file='/media/labs/rsmith/lab-members/gkozlowski/Cooperation/Active_Inference_and_RL_Models_VB_Cooperation_Task/RL_heuristic_scripts/main_script_RL.m'
elif [ "$USER" == "kchou" ]; then
    run_file='/media/labs/rsmith/lab-members/kchou/COP_wellbeing/Final_RL_KPC_heuristic/main_script_RL.m'
fi

matlab -nodisplay -nosplash < ${run_file}